+    # ④ 字段识别与令牌化（privacy 实例已在 ③.5 建好）
     try:
         masked = privacy.mask(raw_text, request_id)
     except Exception as exc:
@@ -208,6 +232,16 @@ async def handle_case(*, case_id: str, emp_id: str, session_id: str | None, note
                       "agent_version": meta["agent_version"],
                       "model": f"{meta['model_supplier']}/{meta['model_version']}"})
 
+    # ⑩.5【补丁 v1.5.3 · T10】规则覆盖动作码：强制人工/规则冲突时收敛为 HUMAN_REVIEW
+    _ov = verdict.get("action_override")
