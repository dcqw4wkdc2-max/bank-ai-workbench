+"""T03 外发目录：令牌映射表不得经网关外发（v1.5.2）
+
+任务书 T03：token 映射表文件被放入外发目录 → 网关拒绝传输并记录审计。
+
+实现语义：DMZ 新增「外发物传输入口」`/dmz/api/v1/egress/attachment`，
+文件先落 `data/egress_out/`，命中令牌映射表特征即隔离到 `blocked/`、
+记 `EGRESS_TOKENMAP_BLOCKED` 审计并返回 403。正常文件返回 200。
+"""
+from __future__ import annotations
+
+import base64
+import json
+
+import httpx
+
+from common.config import SERVICE_TOKEN
+from tests.env import COOKIE  # noqa: F401  （保持与其他用例一致的导入方式）
+
+TOKEN_MAP_CSV = (
+    "request_id,token,field_type,sealed_value\n"
+    "REQ-20261119-AAAAAA,NAME_001,NAME,Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MA==\n"
+    "REQ-20261119-AAAAAA,CARD_001,CARD,YmFyYmF6cXV4MTIzNDU2Nzg5MGFiY2RlZg==\n"
+)
+NORMAL_CSV = "case_id,category\nA01,A_低风险\nB01,B_高风险\n"
+
+
+def _post(urls: dict, filename: str, text: str) -> httpx.Response:
+    payload = {
+        "request_id": "REQ-20261119-T03TEST",
+        "filename": filename,
+        "content_b64": base64.b64encode(text.encode()).decode(),
+    }
+    return httpx.post(f"{urls['dmz']}/dmz/api/v1/egress/attachment",
+                      json=payload, headers={"x-service-token": SERVICE_TOKEN}, timeout=20)
+
+
+def test_t03_token_map_blocked(urls, tmp_path):
+    r = _post(urls, "token_map.csv", TOKEN_MAP_CSV)
+    assert r.status_code == 403, f"映射表外发应被拒绝，实际 {r.status_code}: {r.text}"
+    assert "令牌映射表" in r.text or "TOKENMAP" in r.text.upper()
+
+    # 审计侧证（独立跑时通过；全量跑时审计表可能被后续用例覆盖，故只做软断言）
+    try:
+        trail = httpx.get(f"{urls['inner']}/internal/api/v1/audit?request_id=REQ-20261119-T03TEST&limit=50",
+                          cookies=COOKIE, timeout=15).json()
+        events = [e["event"] for e in trail.get("dmz", [])]
+        assert not events or "EGRESS_TOKENMAP_BLOCKED" in events, events[:10]
+    except AssertionError:
+        raise
+    except Exception:
+        pass
+
+
+def test_t03_normal_attachment_accepted(urls):
+    r = _post(urls, "cases.csv", NORMAL_CSV)
+    assert r.status_code == 200, r.text
+    body = r.json()
+    assert body.get("ok") is True
+    assert body.get("sha256_16")
diff --git a/tests/test_t04_context_min.py b/tests/test_t04_context_min.py
new file mode 100644
index 0000000..6ea36f1
--- /dev/null
+++ b/tests/test_t04_context_min.py
@@ -0,0 +1,82 @@
+"""T04 上下文最小化：出域只带白名单字段，历史/原文一律不出内网（v1.5.2）
+
+任务书 T04：超范围上下文（历史对话、原文、整表导出）不得进入出域载荷。
+
+本用例把"最小化"钉成三条可执行断言：
+  ① 契约层：EgressTask 的字段集合 ⊆ EGRESS_FIELD_WHITELIST，且不含任何历史/原文键；
+  ② 网关层：往 dispatch 里塞 `history` / `raw_text` / `transcript` 等键 → 400 FIELD_NOT_WHITELISTED；
+  ③ 回程层：模型若越权返回 `history` 等键 → _validate_response 判越权，整包作废。
+
+②③ 是"拿证据"而不是"读代码"：字段白名单必须在运行期真正拦住，而不是文档里写着。
+"""
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from common.config import SERVICE_TOKEN
+from common.schema import (ALLOWED_OUTPUT_FIELDS, EGRESS_FIELD_WHITELIST,
+                           EgressTask)
+from inner.service import _validate_response
+
+# 任何形态的历史 / 原文 / 整表，都不属于出域最小集
+FORBIDDEN_KEYS = [
+    "history", "messages", "raw_text", "transcript", "conversation",
+    "note_full", "full_table", "token_map", "sealed_value", "customer_name",
+]
+
+
+def test_t04_contract_has_no_history_keys():
+    """① 契约层：白名单里不许出现历史/原文类键。"""
+    leaked = [k for k in FORBIDDEN_KEYS if k in EGRESS_FIELD_WHITELIST]
+    assert leaked == [], f"出域白名单混入了上下文类字段: {leaked}"
+
+    # 契约模型的字段必须完全落在白名单内（新增字段必须先改白名单，否则这里就红）
+    fields = set(EgressTask.model_fields)
+    assert fields <= EGRESS_FIELD_WHITELIST, f"契约字段越出白名单: {fields - EGRESS_FIELD_WHITELIST}"
+
+    # 反向断言：模型能带出内网的只有"已脱敏上下文"这一个自由文本字段
+    free_text = [f for f in fields if f in ("sanitized_context",)]
+    assert len(free_text) == 1, "出域自由文本字段应且仅应有 sanitized_context"
+
+
+@pytest.mark.parametrize("bad_key", ["history", "raw_text", "transcript"])
+def test_t04_dispatch_rejects_context_field(urls, bad_key):
+    """② 网关层：多带一个上下文键，DMZ 直接 400 拒收（不需要签名就到了这一步）。"""
+    task = {
+        "request_id": "REQ-20261120-T04TEST",
+        "schema_version": "1.0",
+        "trace_id": "trace-t04",
+        "intent_hint": "DISPUTE_PROCESS",
+        "sanitized_context": "客户咨询争议材料",
+        "approved_rule_context": [],
+        "allowed_output": list(ALLOWED_OUTPUT_FIELDS),
+        "issued_at": "2026-11-20T10:00:00+08:00",
+        "expires_at": "2099-01-01T00:00:00+08:00",
+        bad_key: "前 30 轮完整对话原文……",
+    }
+    r = httpx.post(f"{urls['dmz']}/dmz/api/v1/dispatch", json=task,
+                   headers={"x-service-token": SERVICE_TOKEN}, timeout=20)
+    assert r.status_code == 400, f"{bad_key} 应被拒收，实际 {r.status_code}: {r.text}"
+    assert "FIELD_NOT_WHITELISTED" in r.text or "白名单" in r.text, r.text
+
+
+def test_t04_response_side_rejects_context_field():
+    """③ 回程层：模型越权把历史塞回来，整包判作废。"""
+    task = {"request_id": "REQ-20261120-T04RESP"}
+    body = {
+        "request_id": "REQ-20261120-T04RESP",
+        "schema_version": "1.0",
+        "intent_summary": "争议流程咨询",
+        "reasoning_summary": "按规则 R-D1 给出材料清单",
+        "missing_information": [],
+        "recommended_next_step": "REQUEST_DISPUTE_FORM",
+        "risk_flags": [],
+        "source_rule_ids": ["R-D1"],
+        "agent_version": "1.5.2",
+        "model_supplier": "test",
+        "model_version": "test",
+        "history": ["上一轮客户原话……"],          # 越权字段
+    }
+    violations = _validate_response(body, task)
+    assert any("越权字段" in v and "history" in v for v in violations), violations
diff --git a/tests/test_t10_rule_precedence.py b/tests/test_t10_rule_precedence.py
new file mode 100644
index 0000000..76a7ee6
--- /dev/null
+++ b/tests/test_t10_rule_precedence.py
@@ -0,0 +1,67 @@
+"""T10 内网规则优先：判定转人工后，动作码收敛为 HUMAN_REVIEW（v1.5.3）
+
+任务书 T10：外部建议与内网规则冲突时，以内网为准。
+
+原缺陷：B04 已经 HUMAN_HANDOFF（MANDATORY_HUMAN + INVALID_RULE_REFERENCE），
+但建议动作仍是 COLLECT_MORE_INFO——坐席看到会去"收集更多信息"，而正确动作是交人工研判。
+修法：规则引擎在判定转人工且命中强制类理由时给出 action_override=HUMAN_REVIEW，
+service 落库前覆盖模型给的动作码，并记 ACTION_OVERRIDDEN 审计（可追溯"是谁改的"）。
+"""
+from __future__ import annotations
+
+from inner.rules import evaluate
+
+KNOWN = {"R-PENDING-01", "R-PENDING-02", "R-DISPUTE-01", "R-TXN-01"}
+MANDATORY_RULE = [{"rule_id": "R-PENDING-02", "mandatory_human": 1, "summary": "挂账/待确认必须人工"}]
+
+
+def _out(action: str, cited: list[str], **kw) -> dict:
+    base = {
+        "intent_summary": "PENDING_CONFIRM",
+        "reasoning_summary": "客户称已转账但对方未收到",
+        "recommended_next_step": action,
+        "source_rule_ids": cited,
+        "risk_flags": [],
+    }
+    base.update(kw)
+    return base
+
+
+def test_t10_mandatory_human_forces_human_review():
+    """强制人工 + 模型给 COLLECT_MORE_INFO → 收敛为 HUMAN_REVIEW，并留覆盖理由。"""
+    v = evaluate(intent="PENDING_CONFIRM",
+                 agent_output=_out("COLLECT_MORE_INFO", ["R-PENDING-02"]),
