diff --git a/tests/test_case_fault.py b/tests/test_case_fault.py
new file mode 100644
index 0000000..e1d40bd
--- /dev/null
+++ b/tests/test_case_fault.py
@@ -0,0 +1,54 @@
+"""案例级故障演练的验收测试（v1.5.1）
+
+对应 12 例里的 C 组：
+  C03（fault=timeout）  → 工单 TIMEOUT，decision=HUMAN_HANDOFF，无复原结果
+  C04（fault=bad_json） → 工单 REJECTED，decision=HUMAN_HANDOFF
+
+背景：`cases` 表本来就有 fault 字段，但 handle_case 从未读取，
+所以这两例 0.4 秒照常返回 RESTORED。这个测试锁住修复后的行为。
+"""
+from __future__ import annotations
+
+import httpx
+import pytest
+
+from tests.env import TEST_ACCOUNT
+
+
+def _own_cookie(urls: dict) -> dict:
+    """自带会话，不依赖共享 COOKIE —— 避免与其它用例（SINGLE_SESSION）互相顶号。"""
+    r = httpx.post(f"{urls['inner']}/internal/api/v1/auth/login",
+                   json=TEST_ACCOUNT, timeout=20)
+    assert r.status_code == 200, r.text
+    return dict(r.cookies)
+
+
+def _run_case(urls: dict, case_id: str) -> dict:
+    r = httpx.post(f"{urls['inner']}/internal/api/v1/cases",
+                   json={"case_id": case_id, "emp_id": "B001"},
+                   timeout=40, cookies=_own_cookie(urls))
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+@pytest.mark.parametrize(
+    "case_id,expect_status,expect_reason",
+    [
+        ("C03", "TIMEOUT", "UPSTREAM_UNAVAILABLE"),
+        ("C04", "REJECTED", "SCHEMA_INVALID"),
+    ],
+)
+def test_case_fault_short_circuits(urls, case_id, expect_status, expect_reason):
+    d = _run_case(urls, case_id)
+    assert d["status"] == expect_status, f"{case_id} 期望 {expect_status}，实际 {d['status']}"
+    assert d["decision"] == "HUMAN_HANDOFF"
+    assert expect_reason in (d.get("reason_codes") or []), d.get("reason_codes")
+    # fail-closed：故障案例不得产出复原文本
+    assert not d.get("restored_text")
+
+
+def test_case_without_fault_still_normal(urls):
+    """对照组：A01 没有 fault，必须仍然是可展示建议（不能因为改判据被误伤）"""
+    d = _run_case(urls, "A01")
+    assert d["status"] == "RESTORED"
+    assert d["decision"] == "SHOW_SUGGESTION"
diff --git a/tests/test_privacy_judge.py b/tests/test_privacy_judge.py
new file mode 100644
index 0000000..bd4bc31
--- /dev/null
+++ b/tests/test_privacy_judge.py
@@ -0,0 +1,63 @@
+"""隐私三级判据的单元测试（v1.5.1）
+
+对应 12 例验收里的 C 组：
+  C01 带完整证件号          → BLOCKED / PRIVACY_ID_NUMBER
+  C02 要求回拨且给完整手机号 → HUMAN_HANDOFF / CALLBACK_REQUIRES_AUTH
+  A 组正文里的合成卡号/手机号 → 不得命中（否则 A 组全误杀）
+
+这几条是纯函数级验证，不需要起服务。
+"""
+from __future__ import annotations
+
+from inner.privacy import PrivacyService
+
+
+def _svc() -> PrivacyService:
+    return PrivacyService([])  # 不注入已知姓名，判据只看标识形态
+
+
+def test_judge_id_number_blocked():
+    """C01：正文出现 18 位证件号 → BLOCKED"""
+    svc = _svc()
+    text = "客户 张示例 办理查询，客服在备注中粘贴了完整身份信息 110101199001011231 与卡号 6222000000000001。"
+    f = svc.judge(text)
+    assert f is not None
+    assert f["status"] == "BLOCKED"
+    assert f["code"] == "PRIVACY_ID_NUMBER"
+    assert f["severity"] == "critical"
+
+
+def test_judge_card_in_note_blocked():
+    """补充说明里出现完整卡号 → BLOCKED（人把原文贴进了业务文本）"""
+    svc = _svc()
+    f = svc.judge("客户咨询账单明细", note="卡号 6222000000000009 帮我查一下")
+    assert f is not None
+    assert f["status"] == "BLOCKED"
+    assert f["code"] == "PRIVACY_RAW_CARD_IN_NOTE"
+
+
+def test_judge_callback_requires_human():
+    """C02：要求回拨/回访且给了完整手机号 → 转人工（外呼需二次授权）"""
+    svc = _svc()
+    text = "客户 李合成 来电，回拨号码 13800138002，要求回访，并提及姓名与卡号 6222000000000002。"
+    f = svc.judge(text)
+    assert f is not None
+    assert f["status"] == "HUMAN_HANDOFF"
+    assert f["code"] == "CALLBACK_REQUIRES_AUTH"
+
+
+def test_judge_a_group_text_not_hit():
+    """A 组正文含合成卡号/手机号，但没有人粘贴动作 → 不得命中"""
+    svc = _svc()
+    a01 = ("客户 张示例 来电，询问如何对卡号 6222000000000001 的一笔消费发起争议，"
+           "需要准备哪些材料。联系电话 13800138001。")
+    assert svc.judge(a01) is None
+    a03 = "客户 王样测 询问卡号 6222000000000003 上一笔金额 15600.00 元的交易当前状态。"
+    assert svc.judge(a03) is None
+
+
+def test_judge_plain_text_no_hit():
+    svc = _svc()
+    assert svc.judge("想问一下信用卡年费怎么查") is None
+    assert svc.judge("") is None
+    assert svc.judge(None) is None
