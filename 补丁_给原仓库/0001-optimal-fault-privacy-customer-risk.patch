+    def judge(self, text: str, note: str | None = None) -> dict | None:
+        """隐私三级判据：判「人有没有把原始标识贴进业务文本」，不判业务库取来的字段。
+
+        T1  命中 18 位证件号                         → BLOCKED（禁止复原 + 转人工）
